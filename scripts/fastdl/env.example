# ── Autenticação (use UMA das opções) ─────────────────────────────

# Opção A: API Token (recomendado — escopo limitado)
# CLOUDFLARE_API_TOKEN=

# Opção B: Global API Key (acesso total à conta)
# E-mail da conta Cloudflare (My Profile → Email)
CLOUDFLARE_EMAIL=
# My Profile → API Tokens → Global API Key → View
CLOUDFLARE_GLOBAL_API_KEY=

# ── Conta e bucket ────────────────────────────────────────────────

# Account ID: R2 no dashboard → canto direito, ou URL .../accounts/<id>/r2
CLOUDFLARE_ACCOUNT_ID=

# Bucket R2 já criado
R2_BUCKET_NAME=fastdl

# ── Opcional ──────────────────────────────────────────────────────

R2_JURISDICTION=default
TOKEN_NAME=pterodactyl-fastdl
R2_PUBLIC_HOST=fastdl.example.com
R2_PUBLIC_URL=https://fastdl.example.com
